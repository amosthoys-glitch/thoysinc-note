---
import Base from './Base.astro';
import Art from '../components/Art.astro';
import Cta from '../components/Cta.astro';
import { CATS, SITE, type Lang } from '../data/site';
import { formatDate, slugOf, type Note } from '../lib/notes';
import { href } from '../lib/urls';

interface Props {
	note: Note;
}
const { note } = Astro.props;
const lang = note.data.lang as Lang;
const s = SITE[lang];
const slug = slugOf(note);
const catLabel = s.cats[CATS.indexOf(note.data.cat)];
const back = lang === 'ko' ? '← 목록으로' : '← Back to notes';
---

<Base
	lang={lang}
	path={slug}
	section="posts"
	title={`${note.data.title} — ${s.brand}`}
	description={note.data.excerpt}
	ogType="article"
	photo={note.data.photo}
>
	<a class="back" href={href(lang)}>{back}</a>
	<article>
		<Art index={note.data.art} variant="cover" />
		<header>
			<div class="eyebrow">
				{catLabel} &nbsp;·&nbsp; {formatDate(note.data.date)} &nbsp;·&nbsp; {note.data.read}
			</div>
			<h1>{note.data.title}</h1>
			<p class="dek">{note.data.excerpt}</p>
		</header>
		<div class="prose">
			<slot />
		</div>
		<Cta lang={lang} />
	</article>

	<script>
		import '../scripts/terms';
	</script>
</Base>
