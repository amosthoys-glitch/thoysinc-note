// 글 맨 위에 놓는 표지 사진. 소셜 카드(og:image)와 같은 값을 써서
// 공유된 화면과 실제 글머리가 어긋나지 않게 합니다.
// 글을 읽는 데 필요한 정보가 아니라 장식이므로 alt 는 비웁니다.
import { Image } from 'astro:assets';
import { DEFAULT_PHOTO, PHOTOS, type PhotoKey } from '../data/photos';

interface Props {
	photo?: PhotoKey;
}
const { photo } = Astro.props;
const src = PHOTOS[photo ?? DEFAULT_PHOTO];
---

<div class="photo">
	<Image
		src={src}
		alt=""
		widths={[640, 900, 1400]}
		sizes="(max-width: 760px) 100vw, 700px"
		loading="eager"
	/>
</div>
