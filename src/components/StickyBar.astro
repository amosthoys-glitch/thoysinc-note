---
import { SITE, type Lang } from '../data/site';
import { href } from '../lib/urls';
import LangToggle from './LangToggle.astro';

interface Props {
	lang: Lang;
	altHref: string;
	section: 'posts' | 'gloss';
}
const { lang, altHref, section } = Astro.props;
const s = SITE[lang];
---

<div class="stickybar" id="sticky">
	<div class="inner">
		<span class="title">{s.brand}</span>
		<nav class="navlinks">
			<a href={href(lang)} aria-current={section === 'posts' ? 'true' : 'false'}>{s.navPosts}</a>
			<a href={href(lang, 'glossary')} aria-current={section === 'gloss' ? 'true' : 'false'}>
				{s.navGloss}
			</a>
		</nav>
		<LangToggle lang={lang} altHref={altHref} />
	</div>
</div>
