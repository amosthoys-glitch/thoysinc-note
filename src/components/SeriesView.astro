---
import { formatDate, getNotes, slugOf } from '../lib/notes';
import { href } from '../lib/urls';
import type { Lang } from '../data/site';

interface Props {
	lang: Lang;
	series: string;
}
const { lang, series } = Astro.props;

const CIRCLED = '①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳';

// 회차 순서대로. 게재일이 안 된 회차는 getNotes 가 이미 걸러 냅니다.
const episodes = (await getNotes(lang))
	.filter((n) => n.data.series === series && n.data.episode)
	.sort((a, b) => (a.data.episode ?? 0) - (b.data.episode ?? 0));
---

<ol class="series-list">
	{
		episodes.map((note) => (
			<li>
				<a href={href(lang, slugOf(note))}>
					<span class="no">{CIRCLED[(note.data.episode ?? 1) - 1] ?? note.data.episode}</span>
					<span class="body">
						<span class="t">{note.data.title}</span>
						<span class="x">{note.data.excerpt}</span>
					</span>
					<span class="d">{formatDate(note.data.date)}</span>
				</a>
			</li>
		))
	}
</ol>

{episodes.length === 0 && <p class="empty">아직 공개된 회차가 없습니다.</p>}

<style>
	.series-list {
		margin: 26px 0 0;
		padding: 0;
		list-style: none;
	}
	.series-list li {
		border-bottom: 1px solid var(--rule);
	}
	.series-list a {
		display: grid;
		grid-template-columns: 44px 1fr 96px;
		gap: 0 18px;
		align-items: baseline;
		padding: 20px 8px 20px 0;
		color: inherit;
		text-decoration: none;
		transition: background 0.2s, padding-left 0.2s;
	}
	.series-list a:hover {
		background: var(--surface);
		padding-left: 8px;
	}
	.series-list a:hover .t {
		color: var(--accent);
	}
	.no {
		font-size: 20px;
		color: var(--seal);
	}
	.t {
		display: block;
		font-family: var(--display);
		font-weight: 700;
		font-size: 19px;
		letter-spacing: -0.026em;
		line-height: 1.3;
		transition: color 0.18s;
	}
	.x {
		display: block;
		margin-top: 5px;
		color: var(--ink-soft);
		font-size: 14.5px;
	}
	.d {
		font-family: var(--mono);
		font-size: 11.5px;
		color: var(--ink-faint);
		text-align: right;
	}
	.empty {
		color: var(--ink-faint);
	}
	@media (max-width: 640px) {
		.series-list a {
			grid-template-columns: 34px 1fr;
			gap: 0 12px;
		}
		.d {
			display: none;
		}
	}
</style>
