// 같은 글의 반대 언어 URL 로 가는 링크입니다. 언어마다 실제 주소가 생깁니다.
import { type Lang } from '../data/site';

interface Props {
	lang: Lang;
	altHref: string;
}
const { lang, altHref } = Astro.props;
---

<div class="lang">
	{
		lang === 'ko' ? (
			<>
				<span class="cur" aria-current="true"><span>KO</span></span>
				<a href={altHref} hreflang="en" lang="en">EN</a>
			</>
		) : (
			<>
				<a href={altHref} hreflang="ko" lang="ko">KO</a>
				<span class="cur" aria-current="true"><span>EN</span></span>
			</>
		)
	}
</div>
