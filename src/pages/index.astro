import Base from '../layouts/Base.astro';
import NoteList from '../components/NoteList.astro';
import { SITE } from '../data/site';

const lang = 'ko' as const;
const s = SITE[lang];
// 검색 결과용 설명(화면 소개 문구보다 조금 길게. Bing: 설명이 너무 짧음, 2026-11-25).
const metaDescription =
	"은퇴 준비를 처음 시작하는 분을 위한 보험·연금 노트입니다. 애리조나 라이선스 에이전트가 생명보험, 고정·인덱스 연금, 401(k)·IRA·Roth IRA, 사업주 절세 플랜을 상담에서 가장 많이 받는 질문 순서대로 쉬운 말로 풀어 씁니다. 매주 신문 칼럼도 함께 올립니다.";
---

<Base lang={lang} section="posts" title={`${s.brand} — ${s.eyebrow}`} description={metaDescription}>
	<NoteList lang={lang} />
</Base>
