import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { EMAIL } from '../data/cta';

const lang = 'ko' as const;
const s = SITE[lang];
// 내용이 바뀌면 이 날짜를 함께 고칩니다.
const UPDATED = '2026년 11월 2일';
---

<Base
	lang={lang}
	path="privacy"
	hasAlt={false}
	section="privacy"
	title={`개인정보처리방침 — ${s.brand}`}
	description="Thoys 보험 노트(thoysinc.com)가 방문자 정보를 어떻게 다루는지 설명합니다."
>
	<article class="prose privacy">
		<h1>개인정보처리방침</h1>
		<p class="updated">최종 수정일: {UPDATED}</p>

		<p>
			Thoys 보험 노트(www.thoysinc.com, 이하 "이 사이트")는 방문자의 개인정보를 소중히 다룹니다. 이 문서는 이 사이트가 어떤
			정보를 어떻게 다루는지 설명합니다.
		</p>

		<h2>1. 직접 받는 정보</h2>
		<p>
			이 사이트에는 회원 가입이나 댓글 기능이 없습니다. 방문자가 상담을 예약하거나 이메일로 문의하는 경우에만 이름, 연락처,
			문의 내용을 받습니다. 이 정보는 상담과 답장을 위해서만 쓰고, 판매하거나 마케팅 목적으로 제3자에게 넘기지 않습니다. 상담
			중에 알게 된 개인 재무·건강 정보는 보험 업무 규정에 따라 비밀로 다룹니다.
		</p>
		<p>
			상담 예약은 Microsoft Outlook 예약 페이지에서 이루어집니다. 예약할 때 입력하는 정보는 Microsoft의 개인정보처리방침에
			따라 함께 처리됩니다.
		</p>

		<h2>2. 방문 통계</h2>
		<p>
			어떤 글이 읽히는지 알기 위해 Microsoft Azure Application Insights로 페이지 방문과 상담 버튼 클릭을 기록합니다. 이 기록에는
			본 페이지 주소, 이전 페이지 주소, 브라우저 언어가 들어가며, <b>쿠키를 쓰지 않아</b> 재방문자를 같은 사람으로 묶지 않습니다.
			이름이나 연락처 같은 개인 식별 정보는 담기지 않습니다.
		</p>
		<p>
			이 사이트는 Microsoft Azure Static Web Apps에서 운영됩니다. 다른 웹사이트와 마찬가지로 호스팅 서버는 접속 시 IP 주소,
			브라우저 종류 같은 기술 정보를 보안과 운영 목적으로 기록할 수 있습니다.
		</p>

		<h2>3. 쿠키와 광고</h2>
		<p>이 사이트와 같은 도메인의 사이트에는 Google AdSense 광고가 게재될 수 있습니다. 광고가 게재되는 경우:</p>
		<ul>
			<li>
				Google을 포함한 제3자 공급업체는 쿠키를 사용하여 방문자가 이 사이트나 다른 웹사이트를 이전에 방문한 기록을 바탕으로
				광고를 게재합니다.
			</li>
			<li>
				Google은 광고 쿠키를 사용하여 이 사이트 및 인터넷의 다른 사이트 방문 기록을 바탕으로 방문자에게 맞춤 광고를 게재할 수
				있습니다.
			</li>
			<li>
				방문자는 <a href="https://adssettings.google.com" target="_blank" rel="noopener">Google 광고 설정</a>에서 맞춤 광고를
				해제할 수 있으며, <a href="https://www.aboutads.info" target="_blank" rel="noopener">www.aboutads.info</a>에서 제3자
				공급업체의 맞춤 광고 쿠키 사용을 해제할 수 있습니다.
			</li>
			<li>
				Google이 데이터를 사용하는 방식은
				<a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener"
					>Google 파트너 사이트 데이터 사용 안내</a
				>에서 확인할 수 있습니다.
			</li>
		</ul>
		<p>브라우저 설정에서 쿠키를 거부하거나 삭제할 수 있습니다. 쿠키를 거부해도 이 사이트의 글은 그대로 읽을 수 있습니다.</p>

		<h2>4. 외부 링크</h2>
		<p>글 안의 외부 링크로 이동한 뒤에는 그 사이트의 개인정보처리방침이 적용됩니다.</p>

		<h2>5. 어린이의 개인정보</h2>
		<p>이 사이트는 13세 미만 어린이를 대상으로 하지 않으며, 어린이의 개인정보를 의도적으로 수집하지 않습니다.</p>

		<h2>6. 문의</h2>
		<p>
			개인정보와 관련한 문의는 <a href={`mailto:${EMAIL}`}>{EMAIL}</a>로 보내 주세요. 이 방침이 바뀌면 이 페이지에 고친 날짜와 함께
			알립니다.
		</p>
	</article>

	<style>
		.privacy {
			max-width: 46em;
			margin: 40px auto 60px;
			padding: 0 20px;
		}
		.privacy .updated {
			color: var(--ink-faint);
			font-size: 14px;
		}
		.privacy ul {
			margin: 0 0 20px;
			padding-left: 1.2em;
		}
		.privacy li {
			margin: 0 0 8px;
		}
	</style>
</Base>
