// Copyright (c) 2026 Thoys Inc.
import Base from '../layouts/Base.astro';
import SeriesView from '../components/SeriesView.astro';
import { SITE } from '../data/site';
import { getNotes } from '../lib/notes';

const lang = 'ko' as const;
const s = SITE[lang];
const SERIES = '은퇴까지 10년, 매주 한 걸음';

// 뒤이은 연재. 첫 회가 공개되기 전까지는 목차에 드러내지 않습니다.
const LATER = [
	{
		name: '한 해를 닫고 새해를 여는 재정 점검',
		lede: '연말과 새해에 맞춰 은퇴 계획과 가족 보장을 한 번 더 점검하는 칼럼입니다.',
	},
	{
		name: '세상 이야기로 읽는 은퇴',
		lede: '경제·일·교육·가족의 변화에서 출발해 은퇴와 생명보험, 리빙 베네핏을 다시 보는 칼럼입니다.',
	},
];
const published = new Set((await getNotes(lang)).map((n) => n.data.series).filter(Boolean));
const later = LATER.filter((x) => published.has(x.name));
---

<Base
	lang={lang}
	path="series"
	section="series"
	title={`${SERIES} — ${s.brand}`}
	description="애리조나 한인신문에 매주 연재 중인 은퇴 준비 칼럼. 생활비와 소셜시큐리티의 차액에서 출발해 한 주에 한 걸음씩 나아갑니다."
>
	{
		later.toReversed().map((x) => (
			<section class="later">
				<div class="section-head"><h2>{x.name}</h2></div>
				<p class="lede">{x.lede} 신문에 실린 뒤 이곳에 올립니다.</p>
				<SeriesView lang={lang} series={x.name} />
			</section>
		))
	}

	<div class="section-head"><h2>{SERIES}</h2></div>
	<p class="lede">
		애리조나 한인신문에 매주 연재하는 칼럼입니다. 첫 회에서 잡은 <b>부족액</b>(생활비 −
		소셜시큐리티)을 회차마다 하나씩 메워 갑니다. 신문에 실린 뒤 이곳에 올립니다.
	</p>
	<SeriesView lang={lang} series={SERIES} />

	<style>
		.lede {
			max-width: 58ch;
			margin: 20px 0 8px;
			color: var(--ink-soft);
		}
		.later {
			margin-bottom: 56px;
		}
	</style>
</Base>
